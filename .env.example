# ==============================================================
# HARDEV SOLAR SERVICES - ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env.local and configure your environment.
# Do NOT put real credentials into version control.
# ==============================================================

# MongoDB Connection String (Mongoose cached connection)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hardev-solar-services?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hardev-solar-services

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://hardevsolar.com

# Admin Authentication
ADMIN_EMAIL=chandrakantpalse@gmail.com
ADMIN_PASSWORD_HASH=placeholder_salt_and_hash_string
AUTH_SECRET=super-secure-auth-secret-replace-in-production
JWT_SECRET=super-secure-auth-secret-replace-in-production

# Resend API Key for automated lead email notifications
RESEND_API_KEY=re_placeholder_api_key

# Leads Notification Email
LEADS_NOTIFICATION_EMAIL=chandrakantpalse@gmail.com

# WhatsApp Business Contact Number (numeric with country code, no + or spaces)
WHATSAPP_NUMBER=919822823115
NEXT_PUBLIC_WHATSAPP_NUMBER=919822823115

# Primary Contact Phone
CONTACT_PHONE=+91 98228 23115
NEXT_PUBLIC_CONTACT_PHONE=+91 98228 23115
